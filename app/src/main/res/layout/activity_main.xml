<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RADIICALL MUSIC"
            android:textColor="@color/blue_light"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.14" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Sua biblioteca"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/libraryCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="0 músicas"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/importButton"
        android:layout_width="wrap_content"
        android:layout_height="46dp"
        android:layout_marginEnd="20dp"
        android:text="Adicionar MP3"
        android:textAllCaps="false"
        android:textStyle="bold"
        app:backgroundTint="@color/blue"
        app:icon="@drawable/ic_add"
        app:cornerRadius="18dp"
        app:layout_constraintBottom_toBottomOf="@id/header"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/audioPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="22dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/stroke"
        app:strokeWidth="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONTROLE DE ÁUDIO"
                android:textColor="@color/blue_light"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView android:layout_width="62dp" android:layout_height="wrap_content" android:text="Graves" android:textColor="@color/text_primary" android:textStyle="bold" />
                <SeekBar android:id="@+id/bassSeek" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:max="100" android:progressTint="@color/blue" android:thumbTint="@color/blue_light" />
                <TextView android:id="@+id/bassValue" android:layout_width="48dp" android:layout_height="wrap_content" android:gravity="end" android:text="50%" android:textColor="@color/text_secondary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView android:layout_width="62dp" android:layout_height="wrap_content" android:text="Agudos" android:textColor="@color/text_primary" android:textStyle="bold" />
                <SeekBar android:id="@+id/trebleSeek" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:max="100" android:progressTint="@color/blue" android:thumbTint="@color/blue_light" />
                <TextView android:id="@+id/trebleValue" android:layout_width="48dp" android:layout_height="wrap_content" android:gravity="end" android:text="0" android:textColor="@color/text_secondary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView android:layout_width="62dp" android:layout_height="wrap_content" android:text="Volume" android:textColor="@color/text_primary" android:textStyle="bold" />
                <SeekBar android:id="@+id/volumeSeek" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:max="100" android:progressTint="@color/blue" android:thumbTint="@color/blue_light" />
                <TextView android:id="@+id/volumeValue" android:layout_width="48dp" android:layout_height="wrap_content" android:gravity="end" android:text="85%" android:textColor="@color/text_secondary" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        app:layout_constraintBottom_toTopOf="@id/miniPlayer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/audioPanel">

        <ImageView
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:background="@drawable/circle_green_soft"
            android:padding="23dp"
            android:src="@drawable/ic_headphones"
            app:tint="@color/blue_light" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="Sua música, do seu jeito"
            android:textColor="@color/text_primary"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="290dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Adicione seus MP3 e ajuste graves, agudos e volume. A reprodução continua em segundo plano."
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/emptyImportButton"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginTop="22dp"
            android:text="Escolher músicas"
            android:textAllCaps="false"
            android:textStyle="bold"
            app:backgroundTint="@color/blue"
            app:cornerRadius="20dp"
            app:icon="@drawable/ic_folder_music" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/trackList"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="100dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/audioPanel" />

    <LinearLayout
        android:id="@+id/miniPlayer"
        android:layout_width="0dp"
        android:layout_height="84dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_player"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="10dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/circle_green_soft"
            android:padding="13dp"
            android:src="@drawable/ic_wave"
            app:tint="@color/blue_light" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp">
            <TextView
                android:id="@+id/nowPlayingTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Nenhuma música"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/nowPlayingSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Pausado"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/previous"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@android:color/transparent"
            android:contentDescription="Anterior"
            android:src="@drawable/ic_previous"
            app:tint="@color/text_primary" />

        <ImageButton
            android:id="@+id/playPause"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/circle_green"
            android:contentDescription="Tocar ou pausar"
            android:padding="12dp"
            android:src="@drawable/ic_play"
            app:tint="@color/bg" />

        <ImageButton
            android:id="@+id/next"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@android:color/transparent"
            android:contentDescription="Próxima"
            android:src="@drawable/ic_next"
            app:tint="@color/text_primary" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
